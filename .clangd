Diagnostics:
  ClangTidy:
    FastCheckFilter: None
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    IgnoreHeader:
      - 'fmt/.*'
      - '(gtest|gmock)/.*'
      - 'Windows Kits/10/Include/.*/(ucrt|shared|um|winrt|cppwinrt)/.*'
---
If:
  PathMatch: (include|src|tests)/.*
CompileFlags:
  Add: [-Werror, -Werror=sign-compare]
---
If:
  PathMatch: third_party/.*
Diagnostics:
  Suppress: '*'
